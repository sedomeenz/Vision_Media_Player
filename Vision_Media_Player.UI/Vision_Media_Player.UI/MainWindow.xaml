<Window x:Class="Vision_Media_Player.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Title="Vision Media Player"
        Width="1440"
        Height="850"
        MinWidth="1100"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="96"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="205"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="285"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT SIDEBAR -->
        <Border Grid.Row="0" Grid.Column="0"
                Background="{StaticResource SidebarBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <Grid Margin="15,22,15,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="95"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="10,0,0,10">
                    <TextBlock Text="V I S I O N" FontSize="23" FontWeight="Bold"
                               Foreground="{StaticResource PinkBrush}"/>
                    <TextBlock Text="HI-RES MUSIC PLAYER" FontSize="10" Margin="0,5,0,0"
                               Foreground="{StaticResource MutedTextBrush}"/>
                </StackPanel>

                <StackPanel Grid.Row="1">
                    <Button Style="{StaticResource NavButton}" Background="#30206D"
                            Foreground="White" Content="  ◆   Home" Margin="0,3"/>
                    <Button Style="{StaticResource NavButton}" Content="  ♫   All Music" Margin="0,3"/>
                    <Button Style="{StaticResource NavButton}" Content="  ●   Albums" Margin="0,3"/>
                    <Button Style="{StaticResource NavButton}" Content="  ▶   Videos" Margin="0,3"/>
                </StackPanel>

                <TextBlock Grid.Row="2" Text="YOUR COLLECTION" FontSize="10"
                           Foreground="{StaticResource MutedTextBrush}" Margin="12,25,0,12"/>

                <StackPanel Grid.Row="3">
                    <Button Style="{StaticResource NavButton}" Content="  ☷   Playlists" Margin="0,3"/>
                    <Button Style="{StaticResource NavButton}" Content="  ⚙   Settings" Margin="0,3"/>
                </StackPanel>

                <StackPanel Grid.Row="4" Margin="10,15,0,0">
                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,15"/>
                    <TextBlock Text="VISION MEDIA PLAYER" FontSize="10"
                               Foreground="{StaticResource MutedTextBrush}"/>
                    <TextBlock Text="Version 1.0" FontSize="10"
                               Foreground="{StaticResource MutedTextBrush}" Margin="0,6,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN CONTENT -->
        <Grid Grid.Row="0" Grid.Column="1" Margin="28,22,25,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="85"/>
                <RowDefinition Height="55"/>
                <RowDefinition Height="245"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Your Music" FontSize="28" FontWeight="Bold"/>
                    <TextBlock Text="Your personal music collection" FontSize="13"
                               Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,0"/>
                </StackPanel>
                <Button Content="＋  Import Media" Style="{StaticResource AccentButton}"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Click="AddMedia_Click"/>
            </Grid>

            <Grid Grid.Row="1" Margin="0,5,0,12">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="All" Background="{StaticResource AccentGradient}"
                            Foreground="White" BorderThickness="0" Padding="19,8"
                            Margin="0,0,10,0" Click="AllMedia_Click"/>
                    <Button Content="Audio" Margin="0,0,10,0" Click="Audio_Click"/>
                    <Button Content="Video" Margin="0,0,10,0" Click="Video_Click"/>
                    <Button Content="Delete" Margin="0,0,10,0" Click="DeleteMedia_Click"/>
                </StackPanel>
                <TextBox x:Name="SearchTextBox" Width="250" Height="40"
                         Style="{StaticResource SearchBoxStyle}"
                         HorizontalAlignment="Right" VerticalAlignment="Center"
                         TextChanged="SearchTextBox_TextChanged"
                         ToolTip="Search your collection"/>
            </Grid>

            <!-- VIDEO PLAYER PANEL -->
            <Border Grid.Row="2" Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="13" Padding="12" Margin="0,0,0,15">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <TextBlock Text="NOW PLAYING" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{StaticResource PinkBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="VIDEO PREVIEW" FontSize="10"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <Border Grid.Row="1" Background="#050719" CornerRadius="8" ClipToBounds="True">
                        <vlc:VideoView x:Name="VideoView"
                                       Background="#050719"/>
                    </Border>
                </Grid>
            </Border>

            <!-- MEDIA LIBRARY -->
            <Border Grid.Row="3" Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="12" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <TextBlock Text="▣   Media Library" FontSize="17"
                                   FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock Text="Double-click a track to play" FontSize="10"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <ListView x:Name="MediaList" Grid.Row="1" Margin="0,5,0,0"
                              Background="Transparent" BorderThickness="0"
                              SelectionMode="Single"
                              ItemContainerStyle="{StaticResource MediaListItemStyle}"
                              MouseDoubleClick="MediaList_MouseDoubleClick">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="TITLE" Width="270" DisplayMemberBinding="{Binding Name}"/>
                                <GridViewColumn Header="TYPE" Width="90" DisplayMemberBinding="{Binding Type}"/>
                                <GridViewColumn Header="DURATION" Width="100"
                                                DisplayMemberBinding="{Binding Duration, StringFormat={}{0:hh\\:mm\\:ss}}"/>                        </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </Border>
        </Grid>

        <!-- RIGHT PLAYLIST PANEL -->
        <Border Grid.Row="0" Grid.Column="2" Background="{StaticResource SidebarBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0">
            <Grid Margin="18,25,18,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="48"/>
                    <RowDefinition Height="48"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="45"/>
                    <RowDefinition Height="190"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="♫   Your Playlists" FontSize="17"
                           FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Button Grid.Row="1" Content="＋  Create Playlist"
                        Style="{StaticResource AccentButton}" Margin="0,3,0,8"
                        Click="CreatePlaylist_Click"/>
                <ListBox x:Name="PlaylistsListBox" DisplayMemberPath="Name"
                         Grid.Row="2" SelectionMode="Single"
                         SelectionChanged="PlaylistsListBox_SelectionChanged"
                         Margin="0,5,0,5"/>
                <TextBlock Grid.Row="3" Text="♫   Playlist Contents" FontSize="14"
                           FontWeight="SemiBold" VerticalAlignment="Center"/>
                <ListBox x:Name="PlaylistMediaListBox" DisplayMemberPath="Name"
                         Grid.Row="4" Height="190" Margin="0,5,0,8"
                         SelectionMode="Single"/>
                <StackPanel Grid.Row="5">
                    <Button Content="▶  Play Playlist" Margin="0,0,0,8"
                            Click="PlayPlaylist_Click"/>
                    <Button Content="＋  Add Selected Media" Margin="0,0,0,8"
                            Click="AddMediaToPlaylist_Click"/>
                    <Button Content="Remove Selected Media"
                            Foreground="{StaticResource PinkBrush}"
                            BorderBrush="{StaticResource PurpleBrush}"
                            Click="RemoveMediaFromPlaylist_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- BOTTOM PLAYER BAR -->
        <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                Background="#0D1230" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1,1,1,0" CornerRadius="10,10,0,0" Padding="22,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="230"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="285"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="52" Height="52" Background="{StaticResource PanelLightBrush}" CornerRadius="7">
                        <TextBlock Text="♫" FontSize="26" Foreground="{StaticResource PinkBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center" Margin="12,0,0,0">
                        <TextBlock Text="Vision Media Player" FontWeight="SemiBold" FontSize="13"/>
                        <TextBlock x:Name="NowPlayingText" Text="Ready to play"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="11" Margin="0,4,0,0" MaxWidth="155"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </StackPanel>

                <Grid Grid.Column="1" Margin="15,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="25"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <TextBlock x:Name="CurrentTimeText" Text="00:00" FontSize="10"
                                   Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="DurationText" Text="00:00" FontSize="10"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <Slider x:Name="ProgressSlider"
                            Grid.Row="1"
                            Minimum="0"
                            Maximum="100"
                            Value="0"
                            Style="{StaticResource PlayerSliderStyle}"
                            VerticalAlignment="Center"
                            PreviewMouseLeftButtonUp="ProgressSlider_PreviewMouseLeftButtonUp"
                            KeyUp="ProgressSlider_KeyUp"/>
                </Grid>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">

                    <Button x:Name="PlayButton"
                            Content="▶"
                            Style="{StaticResource PlayerPrimaryButtonStyle}"
                            Margin="0,0,7,0"
                            Click="Play_Click"/>

                    <Button x:Name="PauseButton"
                            Content="Ⅱ"
                            Style="{StaticResource PlayerControlButtonStyle}"
                            Margin="0,0,7,0"
                            Click="PauseResume_Click"/>

                    <Button Content="■"
                            Style="{StaticResource PlayerControlButtonStyle}"
                            Margin="0,0,10,0"
                            Click="stop_Click"/>

                    <Button x:Name="MuteButton"
                            Content="🔊"
                            Style="{StaticResource PlayerControlButtonStyle}"
                            FontSize="15"
                            Margin="0,0,7,0"
                            Click="Mute_Click"/>

                    <Slider x:Name="VolumeSlider"
                            Width="85"
                            Minimum="0"
                            Maximum="100"
                            Value="50"
                            Style="{StaticResource PlayerSliderStyle}"
                            VerticalAlignment="Center"
                            ValueChanged="VolumeSlider_ValueChanged"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
