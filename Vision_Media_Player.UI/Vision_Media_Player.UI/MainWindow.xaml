
<Window x:Class="Vision_Media_Player.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Title="Vision Media Player"
        Height="700"
        Width="1200"
        MinHeight="600"
        MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="BlueViolet"
        Foreground="Black">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- App title -->
        <TextBlock Grid.Row="0"
                   Text="Vision Media Player"
                   FontSize="26"
                   FontWeight="Bold"
                   Margin="0,0,0,16"/>

        <!-- Library filters -->
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    Margin="0,0,0,12">

            <Button Content="Add Media"
                    Width="110"
                    Height="32"
                    Margin="0,0,8,0"
                    Click="AddMedia_Click"/>

            <Button Content="All Media"
                    Width="100"
                    Height="32"
                    Margin="0,0,8,0"
                    Click="AllMedia_Click"/>

            <Button Content="Audio"
                    Width="80"
                    Height="32"
                    Margin="0,0,8,0"
                    Click="Audio_Click"/>

            <Button Content="Video"
                    Width="80"
                    Height="32"
                    Margin="0,0,8,0"
                    Click="Video_Click"/>

            <Button Content="Delete"
                    Width="80"
                    Height="32"
                    Margin="0,0,8,0"
                    Click="DeleteMedia_Click"/>

            <TextBox x:Name="SearchTextBox"
                     Width="180"
                     Height="32"
                     Margin="16,0,8,0"
                     VerticalContentAlignment="Center"
                     ToolTip="Enter a media title"
                     TextChanged="SearchTextBox_TextChanged"/>

        </StackPanel>

        <!-- Main content -->
        <Grid Grid.Row="2"
              Margin="0,0,0,12">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.7*"/>
                <ColumnDefinition Width="1.4*"/>
                <ColumnDefinition Width="250"/>
            </Grid.ColumnDefinitions>

            <!-- Video player -->
            <Border Grid.Column="0"
                    Background="Black"
                    Margin="0,0,12,0">

                <vlc:VideoView x:Name="VideoView"/>

            </Border>

            <!-- Media Library -->
            <GroupBox Grid.Column="1"
                      Header="Media Library"
                      Foreground="Black"
                      Margin="0,0,12,0"
                      Padding="5">

                <ListView x:Name="MediaList"
                          Background="#252525"
                          Foreground="White"
                          BorderThickness="0"
                          MouseDoubleClick="MediaList_MouseDoubleClick">

                    <ListView.View>
                        <GridView>

                            <GridViewColumn Header="Name"
                                            Width="150"
                                            DisplayMemberBinding="{Binding Name}"/>

                            <GridViewColumn Header="Type"
                                            Width="65"
                                            DisplayMemberBinding="{Binding Type}"/>

                            <GridViewColumn Header="Duration"
                                            Width="75"
                                            DisplayMemberBinding="{Binding Duration}"/>

                        </GridView>
                    </ListView.View>

                </ListView>

            </GroupBox>

            <!-- Playlists Panel -->
            <GroupBox Grid.Column="2"
                      Header="Playlists"
                      Foreground="Black"
                      BorderBrush="Black"
                      Padding="6">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="1.2*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="1.5*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Create Playlist -->
                    <Button Grid.Row="0"
                            Content="+ Create Playlist"
                            Height="30"
                            Margin="0,0,0,8"
                            Click="CreatePlaylist_Click"/>

                    <!-- Playlist list -->
                    <ListBox x:Name="PlaylistsListBox"
                             Grid.Row="1"
                             Background="#252525"
                             Foreground="White"
                             BorderThickness="0"
                             DisplayMemberPath="Name"
                             SelectionMode="Single"
                             SelectionChanged="PlaylistsListBox_SelectionChanged"/>

                    <!-- Playlist contents title -->
                    <TextBlock Grid.Row="2"
                               Text="Playlist Contents"
                               FontWeight="Bold"
                               Margin="0,12,0,6"/>

                    <!-- Add Media -->
                    <Button Grid.Row="3"
                            Content="Add Selected Media"
                            Height="30"
                            Margin="0,0,0,6"
                            Click="AddMediaToPlaylist_Click"/>

                    <!-- Playlist media list -->
                    <ListBox x:Name="PlaylistMediaListBox"
                             Grid.Row="5"
                             Background="#252525"
                             Foreground="White"
                             BorderThickness="0"
                             DisplayMemberPath="Name"
                             SelectionMode="Single"/>

                    <!-- Remove Media -->
                    <Button Grid.Row="6"
                            Content="Remove Selected Media"
                            Height="30"
                            Margin="0,8,0,0"
                            Click="RemoveMediaFromPlaylist_Click"/>

                </Grid>

            </GroupBox>

        </Grid>

        <!-- Playback controls -->
        <StackPanel Grid.Row="3">

            <Slider x:Name="ProgressSlider"
                    Minimum="0"
                    Maximum="1"
                    Value="0"
                    Margin="0,0,0,4"
                    PreviewMouseLeftButtonUp="ProgressSlider_PreviewMouseLeftButtonUp"
                    KeyUp="ProgressSlider_KeyUp"/>

            <Grid Margin="0,0,0,10">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="CurrentTimeText"
                           Grid.Column="0"
                           Text="00:00"
                           VerticalAlignment="Center"/>

                <TextBlock Grid.Column="1"
                           Text="Playback"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="#AAAAAA"/>

                <TextBlock x:Name="DurationText"
                           Grid.Column="2"
                           Text="00:00"
                           VerticalAlignment="Center"/>

            </Grid>

            <DockPanel LastChildFill="False">

                <StackPanel Orientation="Horizontal"
                            DockPanel.Dock="Left">

                    <Button Content="Play"
                            Width="75"
                            Height="32"
                            Margin="0,0,8,0"
                            Click="Play_Click"/>

                    <Button Content="Stop"
                            Width="75"
                            Height="32"
                            Click="stop_Click"/>

                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            DockPanel.Dock="Right"
                            VerticalAlignment="Center">

                    <Button x:Name="MuteButton"
                            Content="Mute"
                            Width="70"
                            Height="30"
                            Margin="0,0,8,0"
                            Click="Mute_Click"/>

                    <TextBlock Text="Volume"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>

                    <Slider x:Name="VolumeSlider"
                            Width="120"
                            Minimum="0"
                            Maximum="100"
                            Value="50"
                            VerticalAlignment="Center"
                            ValueChanged="VolumeSlider_ValueChanged"/>

                </StackPanel>

            </DockPanel>

        </StackPanel>

    </Grid>
</Window>
